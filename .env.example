# resolve-skills 本机私有凭据模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会入库。
# 三个位置任选（post-comment 按序加载，不覆盖已存在的环境变量）：
#   1) ~/.config/resolve-skills/.env            ← 推荐：任意 checkout（含 resolve-tui submodule）都认
#   2) $HARNESS_SKILLS_ENV → 指向某个 .env 文件
#   3) 本仓库根/.env                            ← 仅源仓库场景
# 可把 1) 直接软链到本仓库的 .env，保持单一数据源。

# WordPress 应用密码认证（post-comment 提交评论必需）
# 用户名：WordPress 登录名
PROD_WORDPRESS_USERNAME=
# 应用密码：形如 "xxxx xxxx xxxx xxxx"（可带引号）
PROD_WORDPRESS_APP_PASSWORD=

# （可选）等价回退变量
# ERISHEN_WP_USER=
# ERISHEN_WP_APP_PASSWORD=

# （可选）站点 base 覆盖，默认 https://example.com（改为你的 WordPress 站点）
# ERISHEN_BASE=

# （可选）weekly-investment-review 工具桥的数据源覆盖
# AUTOGEN_PSE_DIR=