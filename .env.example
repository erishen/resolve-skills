# harness-skills 本机私有凭据模板
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会入库。
# post-comment 技能会在运行时从：
#   --env-dir <目录>/.env → <cwd>/.env → 本仓库根/.env
# 依次加载（不覆盖已存在的环境变量）。

# erishen.cn WordPress 应用密码认证（post-comment 提交评论必需）
# 用户名：WordPress 登录名
PROD_WORDPRESS_USERNAME=
# 应用密码：形如 "xxxx xxxx xxxx xxxx"（可带引号）
PROD_WORDPRESS_APP_PASSWORD=

# （可选）等价回退变量
# ERISHEN_WP_USER=
# ERISHEN_WP_APP_PASSWORD=

# （可选）站点 base 覆盖，默认 https://erishen.cn
# ERISHEN_BASE=

# （可选）weekly-investment-review 工具桥的数据源覆盖
# AUTOGEN_PSE_DIR=